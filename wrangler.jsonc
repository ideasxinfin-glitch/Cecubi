{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cecubi",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  // Sitio estático: `node build.mjs` genera dist/ y `npx wrangler deploy` lo publica.
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash"
  }
}
